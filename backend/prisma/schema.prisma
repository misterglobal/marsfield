datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  passwordHash         String                @map("password_hash")
  name                 String?
  plan                 String                @default("free")
  creditsUsed          Int                   @default(0) @map("credits_used")
  creditsLimit         Int                   @default(15) @map("credits_limit")
  authVersion          Int                   @default(0) @map("auth_version")
  storageUsageBytes    Int                   @default(0) @map("storage_usage_bytes")
  storageLimitBytes    BigInt                @default(1073741824) @map("storage_limit_bytes")
  createdAt            DateTime              @default(now()) @map("created_at")
  projects             Project[]
  predictions          Prediction[]
  assets               Asset[]
  apiKeys              ApiKey[]
  usageEvents          UsageEvent[]
  storageObjects       StorageObject[]
  brandKits            BrandKit[]
  youtubeProductions   YoutubeProduction[]
  feedbackReports      FeedbackReport[]
  freemiusEntitlements FreemiusEntitlement[]
  billingEvents        BillingEvent[]
  passwordResetTokens  PasswordResetToken[]
  influencers          Influencer[]
  influencerProducts   InfluencerProduct[]
  influencerProjects   InfluencerVideoProject[]

  @@map("users")
}

model Influencer {
  id                  String                  @id @default(uuid())
  userId              String                  @map("user_id")
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  profile             Json
  canonicalDescription String?                @map("canonical_description")
  voiceProfile        String?                 @map("voice_profile")
  referenceStorageIds Json?                   @map("reference_storage_ids")
  referenceConsentAt  DateTime?               @map("reference_consent_at")
  status              String                  @default("draft")
  primaryPredictionId String?                 @map("primary_prediction_id")
  primaryAssetId      String?                 @map("primary_asset_id")
  currentVersion      Int                     @default(0) @map("current_version")
  versions            InfluencerVersion[]
  projects            InfluencerVideoProject[]
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("influencers")
}

model InfluencerVersion {
  id                  String       @id @default(uuid())
  influencerId        String       @map("influencer_id")
  influencer          Influencer   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  version             Int
  profile             Json
  canonicalDescription String      @map("canonical_description")
  voiceProfile        String?      @map("voice_profile")
  generationPrompt    String       @map("generation_prompt")
  predictionId        String       @map("prediction_id")
  assetId             String?      @map("asset_id")
  imageUrl            String?      @map("image_url")
  approvedAt          DateTime      @default(now()) @map("approved_at")
  projects            InfluencerVideoProject[]

  @@unique([influencerId, version])
  @@index([predictionId])
  @@map("influencer_versions")
}

model InfluencerProduct {
  id                    String                   @id @default(uuid())
  userId                String                   @map("user_id")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  brandName             String?                  @map("brand_name")
  approvedClaims        Json?                     @map("approved_claims")
  restrictedClaims      Json?                     @map("restricted_claims")
  brandColours          Json?                     @map("brand_colours")
  referenceStorageIds   Json?                     @map("reference_storage_ids")
  primaryStorageObjectId String?                  @map("primary_storage_object_id")
  sourceUrl             String?                   @map("source_url")
  sourceData            Json?                     @map("source_data")
  externalImageUrls     Json?                     @map("external_image_urls")
  projects              InfluencerVideoProject[]
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("influencer_products")
}

model InfluencerVideoProject {
  id                    String                   @id @default(uuid())
  userId                String                   @map("user_id")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId          String                   @map("influencer_id")
  influencer            Influencer               @relation(fields: [influencerId], references: [id])
  influencerVersionId   String                   @map("influencer_version_id")
  influencerVersion     InfluencerVersion        @relation(fields: [influencerVersionId], references: [id])
  productId             String?                  @map("product_id")
  product               InfluencerProduct?       @relation(fields: [productId], references: [id])
  title                 String
  idea                  String
  brief                 Json
  durationSeconds       Int                      @map("duration_seconds")
  aspectRatio           String                   @map("aspect_ratio")
  status                String                   @default("draft")
  scenesRevision        Int                      @default(0) @map("scenes_revision")
  scenesApprovedAt      DateTime?                @map("scenes_approved_at")
  scenes                InfluencerProjectScene[]
  storyboards           InfluencerStoryboardVersion[]
  videoGenerations      InfluencerVideoGeneration[]
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([influencerId])
  @@map("influencer_video_projects")
}

model InfluencerStoryboardVersion {
  id                 String                  @id @default(uuid())
  projectId          String                  @map("project_id")
  project            InfluencerVideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version            Int
  scenesRevision     Int                     @map("scenes_revision")
  sceneSnapshot      Json                    @map("scene_snapshot")
  influencerSnapshot Json                    @map("influencer_snapshot")
  productSnapshot    Json?                   @map("product_snapshot")
  prompt             String
  layout             String
  visualStyle        String                  @map("visual_style")
  referenceStorageIds Json?                  @map("reference_storage_ids")
  predictionId       String                  @unique @map("prediction_id")
  assetId            String?                 @map("asset_id")
  imageUrl           String                  @map("image_url")
  status             String                  @default("completed")
  approved           Boolean                 @default(false)
  approvedAt         DateTime?               @map("approved_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  videoGenerations   InfluencerVideoGeneration[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("influencer_storyboard_versions")
}

model InfluencerVideoGeneration {
  id                 String                       @id @default(uuid())
  projectId          String                       @map("project_id")
  project            InfluencerVideoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboardId       String                       @map("storyboard_id")
  storyboard         InfluencerStoryboardVersion  @relation(fields: [storyboardId], references: [id])
  attempt            Int
  prompt             String
  motionInstructions String?                      @map("motion_instructions")
  settings           Json
  predictionId       String                       @unique @map("prediction_id")
  assetId            String?                      @map("asset_id")
  videoUrl           String                       @map("video_url")
  status             String                       @default("completed")
  approved           Boolean                      @default(false)
  approvedAt         DateTime?                    @map("approved_at")
  creditsUsed        Int                          @default(0) @map("credits_used")
  createdAt          DateTime                     @default(now()) @map("created_at")

  @@unique([projectId, attempt])
  @@index([storyboardId, createdAt])
  @@map("influencer_video_generations")
}

model InfluencerProjectScene {
  id                String                  @id @default(uuid())
  projectId         String                  @map("project_id")
  project           InfluencerVideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index             Int
  title             String
  durationSeconds   Int                     @map("duration_seconds")
  location          String
  description       String
  characterAction   String                  @map("character_action")
  expression        String?
  wardrobe          String
  cameraFraming     String                  @map("camera_framing")
  cameraMovement    String                  @map("camera_movement")
  lighting          String?
  productVisible    Boolean                 @default(false) @map("product_visible")
  dialogue          String?
  voiceover         String?
  onScreenText      String?                 @map("on_screen_text")
  transition        String?
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@unique([projectId, index])
  @@map("influencer_project_scenes")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model Project {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  user           User                   @relation(fields: [userId], references: [id])
  name           String
  description    String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  predictions    Prediction[]
  assets         Asset[]
  scenes         StoryboardScene[]
  brandKits      BrandKit[]
  kitAssignments ProjectKitAssignment[]

  @@index([userId, createdAt])
  @@map("projects")
}

model Prediction {
  id                    String           @id @default(uuid())
  userId                String?          @map("user_id")
  user                  User?            @relation(fields: [userId], references: [id])
  projectId             String?          @map("project_id")
  project               Project?         @relation(fields: [projectId], references: [id])
  storyboardSceneId     String?          @map("storyboard_scene_id")
  storyboardScene       StoryboardScene? @relation(fields: [storyboardSceneId], references: [id])
  workflow              String
  model                 String
  prompt                String?
  inputParams           Json?            @map("input_params")
  variationGroupId      String?          @map("variation_group_id")
  variationIndex        Int              @default(0) @map("variation_index")
  variationCount        Int              @default(1) @map("variation_count")
  creditCost            Int              @default(1) @map("credit_cost")
  status                String           @default("pending")
  replicatePredictionId String?          @map("replicate_prediction_id")
  outputUrl             String?          @map("output_url")
  errorMessage          String?          @map("error_message")
  createdAt             DateTime         @default(now()) @map("created_at")
  completedAt           DateTime?        @map("completed_at")
  assets                Asset[]
  usageEvents           UsageEvent[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([variationGroupId])
  @@map("predictions")
}

model Asset {
  id                       String          @id @default(uuid())
  userId                   String?         @map("user_id")
  user                     User?           @relation(fields: [userId], references: [id])
  projectId                String?         @map("project_id")
  project                  Project?        @relation(fields: [projectId], references: [id])
  predictionId             String?         @map("prediction_id")
  prediction               Prediction?     @relation(fields: [predictionId], references: [id])
  storageObjectId          String?         @unique @map("storage_object_id")
  storageObject            StorageObject?  @relation("AssetOriginal", fields: [storageObjectId], references: [id])
  thumbnailStorageObjectId String?         @unique @map("thumbnail_storage_object_id")
  thumbnailStorageObject   StorageObject?  @relation("AssetThumbnail", fields: [thumbnailStorageObjectId], references: [id])
  url                      String
  type                     String
  thumbnailUrl             String?         @map("thumbnail_url")
  fileSize                 Int?            @map("file_size")
  isFavorite               Boolean         @default(false) @map("is_favorite")
  brandKitAssets           BrandKitAsset[]
  createdAt                DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("assets")
}

model StorageObject {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  user              User?    @relation(fields: [userId], references: [id])
  provider          String   @default("remote_url")
  bucket            String?
  key               String?
  url               String
  mimeType          String?  @map("mime_type")
  byteSize          Int?     @map("byte_size")
  checksum          String?
  createdAt         DateTime @default(now()) @map("created_at")
  asset             Asset?   @relation("AssetOriginal")
  thumbnailForAsset Asset?   @relation("AssetThumbnail")

  @@index([userId, createdAt])
  @@index([provider, bucket, key])
  @@map("storage_objects")
}

model StoryboardScene {
  id              String       @id @default(uuid())
  projectId       String       @map("project_id")
  project         Project      @relation(fields: [projectId], references: [id])
  index           Int
  title           String?
  prompt          String?
  notes           String?
  durationSeconds Int?         @map("duration_seconds")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  predictions     Prediction[]

  @@unique([projectId, index])
  @@map("storyboard_scenes")
}

model UsageEvent {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])
  predictionId String?     @map("prediction_id")
  prediction   Prediction? @relation(fields: [predictionId], references: [id])
  eventType    String      @map("event_type")
  credits      Int
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("usage_events")
}

model FreemiusEntitlement {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  fsLicenseId String    @unique @map("fs_license_id")
  fsPlanId    String?   @map("fs_plan_id")
  fsPricingId String?   @map("fs_pricing_id")
  fsUserId    String?   @map("fs_user_id")
  type        String?
  expiration  DateTime?
  isCanceled  Boolean   @default(false) @map("is_canceled")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, isCanceled])
  @@index([fsPlanId])
  @@map("freemius_entitlements")
}

model BillingEvent {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id])
  provider        String   @default("freemius")
  providerEventId String?  @unique @map("provider_event_id")
  eventType       String   @map("event_type")
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("billing_events")
}

model FeedbackReport {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  type           String
  message        String
  pageUrl        String?   @map("page_url")
  userAgent      String?   @map("user_agent")
  context        Json?
  emailStatus    String    @default("pending") @map("email_status")
  emailMessageId String?   @map("email_message_id")
  emailError     String?   @map("email_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  sentAt         DateTime? @map("sent_at")

  @@index([userId, createdAt])
  @@index([emailStatus, createdAt])
  @@map("feedback_reports")
}

model BrandKit {
  id                 String                 @id @default(uuid())
  userId             String                 @map("user_id")
  user               User                   @relation(fields: [userId], references: [id])
  projectId          String?                @map("project_id")
  project            Project?               @relation(fields: [projectId], references: [id])
  name               String
  kind               String                 @default("brand")
  description        String?
  promptRules        String?                @map("prompt_rules")
  voice              String?
  colors             Json?
  fonts              Json?
  assets             Json?
  kitAssets          BrandKitAsset[]
  projectAssignments ProjectKitAssignment[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("brand_kits")
}

model BrandKitAsset {
  brandKitId String   @map("brand_kit_id")
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  assetId    String   @map("asset_id")
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role       String   @default("reference")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([brandKitId, assetId])
  @@index([assetId])
  @@map("brand_kit_assets")
}

model ProjectKitAssignment {
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandKitId String   @map("brand_kit_id")
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([projectId, brandKitId])
  @@index([brandKitId])
  @@map("project_kit_assignments")
}

model YoutubeProduction {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id])
  projectId           String?  @map("project_id")
  topic               String
  normalizedTopic     Json?    @map("normalized_topic")
  audience            String?
  targetDurationMin   Int      @default(8) @map("target_duration_min")
  status              String   @default("draft")
  research            Json?
  strategy            Json?
  script              Json?
  storyboard          Json?
  narration           Json?
  captions            Json?
  audio               Json?
  seo                 Json?
  thumbnailConcepts   Json?    @map("thumbnail_concepts")
  estimatedCreditsMin Int      @default(200) @map("estimated_credits_min")
  productionMetrics   Json?    @map("production_metrics")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("youtube_productions")
}

model ApiKey {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id])
  key           String    @unique
  name          String?
  prefix        String?
  lastFour      String?   @map("last_four")
  scopes        String[]  @default(["generation:write", "predictions:read"])
  expiresAt     DateTime? @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("api_keys")
}
