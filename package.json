{
  "name": "marsfield-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "dev": "npm run dev --workspaces --parallel",
    "build": "npm run build --workspaces"
  }
}
