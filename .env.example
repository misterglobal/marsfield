# Copy this file to .env before deploying.
POSTGRES_DB=marsfield
POSTGRES_USER=marsfield
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional override. Use this if POSTGRES_PASSWORD contains URL-reserved
# characters such as @, :, /, #, ?, or %. URL-encode the password here.
# DATABASE_URL=postgresql://marsfield:replace-with-a-long-random-password@postgres:5432/marsfield?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
# Separate pepper used to irreversibly hash IP, device, phone, card, domain, and
# content-risk signals. Never rotate it without an account-risk migration.
RISK_SIGNAL_PEPPER=replace-with-another-long-random-value
TRUST_PROXY_HOPS=1
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_INTERVAL_MS=21600000
REPLICATE_API_TOKEN=r8_replace_me
# Retrieve from GET https://api.replicate.com/v1/webhooks/default/secret.
REPLICATE_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# Hidden asset cleanup endpoint. Leave ENABLE_ASSET_DELETE=false for normal
# users; set ADMIN_EMAILS to your account email to allow direct DELETE calls.
ENABLE_ASSET_DELETE=false
ADMIN_EMAILS=creator@marsfield.ai

# Feedback emails via Resend. Verify marsfield.xyz in Resend, send from that
# domain, and receive user reports in the dedicated support Gmail inbox.
RESEND_API_KEY=
OPENAI_API_KEY=
# Optional YouTube storyboard enrichment budget. Falls back to the local planner when exceeded.
YOUTUBE_AI_TIMEOUT_MS=15000
FEEDBACK_FROM_EMAIL=Marsfield Feedback <feedback@marsfield.xyz>
FEEDBACK_TO_EMAIL=marsfieldapp@gmail.com
# Password reset emails. Falls back to FEEDBACK_FROM_EMAIL when omitted.
ACCOUNT_EMAIL_FROM=Marsfield Accounts <accounts@marsfield.xyz>

# Cloudflare Turnstile registration CAPTCHA (secret is backend-only).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Twilio Verify is only required when a risky free account is challenged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Denial-of-wallet controls. Budgets reset at 00:00 UTC. Cost estimates reserve
# capacity before provider work; paid use bypasses only the free-tier budget.
FREE_TIER_DAILY_BUDGET_USD=25
PLATFORM_DAILY_SAFETY_BUDGET_USD=500
GENERATION_COST_PER_CREDIT_USD=0.032
FREE_TRIAL_MAX_CREDITS_PER_JOB=5
FREE_TRIAL_MAX_VARIATIONS=1
FREE_TRIAL_MAX_DURATION_SECONDS=10
PLATFORM_MAX_GENERATION_DURATION_SECONDS=180
FREE_TRIAL_DISABLED_WORKFLOWS=influencer-video,character-replace,video-edit,video-enhance
FREE_TRIAL_DISABLED_MODELS=
FREE_TRIAL_PHONE_RISK_THRESHOLD=50
MAX_CONCURRENT_JOBS_FREE=1
MAX_CONCURRENT_JOBS_STARTER=3
MAX_CONCURRENT_JOBS_CREATOR=5
MAX_CONCURRENT_JOBS_PRO=10
MAX_CONCURRENT_JOBS_STUDIO=20

# Cloudflare R2 durable asset storage.
# Create an R2 API token with Object Read & Write access to this bucket.
R2_BUCKET_URL=https://
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Optional but recommended for browser playback/downloads. Use an R2 public dev
# URL or custom domain, without a trailing slash.
R2_PUBLIC_BASE_URL=

# Public URL used by Replicate to call the webhook through the frontend proxy.
# Example: https://marsfield.example.com
PUBLIC_APP_URL=http://localhost:3000

# Freemius subscriptions. Product secret/API token are secrets; plan/pricing IDs
# are copied from the Freemius dashboard. Set PUBLIC_APP_URL=https://marsfield.xyz
# on the VPS once DNS has propagated.
FREEMIUS_PRODUCT_ID=
FREEMIUS_PRODUCT_SECRET_KEY=
FREEMIUS_API_TOKEN=
FREEMIUS_SUCCESS_URL=
FREEMIUS_CANCEL_URL=
FREEMIUS_STARTER_PLAN_ID=
FREEMIUS_STARTER_PRICING_ID=
FREEMIUS_CREATOR_PLAN_ID=
FREEMIUS_CREATOR_PRICING_ID=
FREEMIUS_PRO_PLAN_ID=
FREEMIUS_PRO_PRICING_ID=
FREEMIUS_STUDIO_PLAN_ID=
FREEMIUS_STUDIO_PRICING_ID=

# Host port exposed by the frontend container.
APP_PORT=3000
